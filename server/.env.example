# Скопировать в .env ВНЕ веб-корня (см. README) и заполнить. Никогда не коммитить .env.
APP_ENV=production
APP_URL=https://example.com
# Домен PWA (для CORS). Несколько — через запятую.
CLIENT_ORIGINS=https://pavel198788.github.io
# Случайная строка 64+ символов: подпись JWT и шифрование токенов интеграций.
APP_KEY=
# База: mysql или sqlite (sqlite — только для тестов/разработки).
DB_DRIVER=mysql
DB_HOST=localhost
DB_NAME=runpath
DB_USER=
DB_PASS=
DB_SQLITE_PATH=storage/runpath.sqlite
# Почта (подтверждение, сброс пароля). smtp или mail (функция mail() хостинга).
MAIL_DRIVER=mail
MAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# ИИ-прокси: ключ владельца. Квоты настраиваются в админке (по умолчанию ниже).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_DAILY_MESSAGES_PER_USER=20
AI_MONTHLY_BUDGET_USD=50
AI_GUEST_DAILY_MESSAGES=3
# Web Push (VAPID). Сгенерировать: php cron/vapid.php
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Секрет для cron-скриптов, если запускаются по HTTP (cron/…?token=)
CRON_TOKEN=
